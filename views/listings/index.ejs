<% layout("/layouts/Boilerplate") %>

<style>
  #filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }
  .filter {
    text-align: center;
    margin-left: 2rem;
    margin-top: 2rem;
    opacity: 0.7;
  }
  .filter:hover {
    opacity: 1;
    cursor: pointer;
  }
  .tax-toggle {
    border: 1px solid black;
    border-radius: 1rem;
    height: 3.25rem;
    padding: 1rem;
    margin-left: 3rem;
    display: flex;
    align-items: center;
  }
  .tax {
    display: none;
  }
</style>

<%=success%>
<!-- <form method="GET" action="/listings/new">
        <button>Create new list</button>
    </form> -->

<div id="filters">
  <div class="filter">
    <div><i class="fa-solid fa-fire"></i></div>
    <p>Trending</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-bed"></i></div>
    <p>Rooms</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-fire"></i></div>
    <p>Iconic city</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-mountain"></i></div>
    <p>Mountain</p>
  </div>
  <div class="filter">
    <div><i class="fa-brands fa-fort-awesome"></i></div>
    <p>Castle</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-person-swimming"></i></div>
    <p>Amazing pool</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-campground"></i></div>
    <p>Camping</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-cow"></i></div>
    <p>Farms</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-snowflake"></i></div>
    <p>Artic</p>
  </div>

  <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
      <input
        class="form-check-input"
        type="checkbox"
        role="switch"
        id="switchCheckDefault"
      />
      <label class="form-check-label" for="switchCheckDefault"
        >Default switch checkbox input</label
      >
    </div>
  </div>
</div>
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
  <% for(let datalist of listData) { %>
  <a href="/listings/<%=datalist._id%>" class="anchor-tag-img">
    <div class="card card-listing">
      <img
        src="<%=datalist.image.url %>"
        class="card-img-top"
        alt="listingsImage"
        style="height: 20rem"
      />
      <div class="card-img-overlay">abc</div>
      <div class="card-body">
        <p class="card-text">
          <b> <%= datalist.title %> </b><br />
          &#8377;<%=(datalist.price) %> /night
          <i class="tax"> +18%GST</i>
        </p>
      </div>
    </div>
  </a>
  <% } %>
</div>

<ul>
  <!-- < for(let datalist of listData) { %>
          
            <li> <a href="/listings/<=datalist._id %>" > <= datalist.title %> </a> </li>
           
        < } > -->
</ul>

<!-- This is function for tax switches -->
<script>
  let infoTax = document.getElementById("switchCheckDefault");
  infoTax.addEventListener("click", () => {
    let taxInfo = document.getElementsByClassName("tax");
    for (info of taxInfo) {
      if (info.style.display != "inline") {
        info.style.display = "inline";
      } else {
        info.style.display = "none";
      }
    }
  });
</script>
