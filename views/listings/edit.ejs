<% layout("/layouts/boilerplate") %>
<body>
    <h2>Edit you propertied details:</h2>
    <div class="row mt-3">
        <div class="col col-8 offset-2">
            <form  method="POST" action="/listings/<%=idlist._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
                <div class="mb-3 ">
                    <label  for="title"   class="form-label">Title</label>
                    <input 
                        name="listing[title]" 
                        value="<%=idlist.title%>"
                        type="text" 
                        class="form-control" 
                        required
                    />
                    <div class="invalid-feedback">Enter Valid title</div>
                </div>
                <div class="mb-3">
                    <label  for="description" class="form-label">Description</label>
                    <textarea 
                        name="listing[description]" 
                        class="form-control" required> 
                        <%=idlist.description%>
                     
                    </textarea>
                    <div class="invalid-feedback">Enter Short description 0-300 </div>

                </div>
                <div class="org">
                    Original Listing image
                    <img src="<%=originalurl%>"/>
                </div>

                <div class="mb-3">
                    <label for="image" class="form-label">upload New Image</label>
                    <input 
                        name="listing[image]" 
                        type="file" 
                        class="form-control"
                    />
                </div>
                <div class="row">

                    <div class="mb-3 col-md-4" >
                        <labe for="price" class="form-label">price</labe>
                        <input
                            name="listing[price]" 
                            value="<%=idlist.price%>"
                            type="number" 
                            class="form-control"
                            required

                        />
                      <div class="invalid-feedback">Enter Valid Price</div>

                    </div>
                    <div class="mb-3 col-md-8">
                        <label for="country" class="form-label">country</label>
                        <input 
                            name="listing[country]" 
                            value="<%=idlist.country%>"
                            type="text" 
                            class="form-control"
                            required

                        />
                      <div class="invalid-feedback">Enter Valid Country</div>

                    </div>
        
                </div>
                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input 
                        name="listing[location]" 
                        value="<%=idlist.location%>"
                        type="text" 
                        class="form-control"
                        required
                    />
                    <div class="invalid-feedback">Enter Valid Location</div>

                </div>
                <button class="btn btn-dark add-btn mt-3">Edit</button>
                
            </form>
    </div>
  </div>
</body>

<script src="/javascript/script.js"></script>
