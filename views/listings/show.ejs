<% layout("/layouts/boilerplate") %>
<script>
    const mapToken="<%=process.env.MAP_TOKEN%>"
    // const Coordinate= <-JSON.stringify(idlist.geometry.coordinates)%>
    const Coordinate = JSON.parse('<%- JSON.stringify(idlist.geometry.coordinates) %>');

</script>

    <div class="row ">
        <div class="col-8 offset-2">
            <h2><%= idlist.title %></h2>
        </div>

        <div class="col-6 offset-3 mt-3">

            <div class="card show-card card-listing">
                <img src="<%=idlist.image.url%>" class="card-img-top show-img" alt="villaImage">
                <div class="card-body">
                    <p class="card-text">Owned by <i><%=idlist.owner.username%></i></p>
                    <p class="card-text"><%= idlist.description %></p>
                    <p class="card-text">&#8377 <%= idlist.price.toLocaleString("en-IN") %></p>
                    <p class="card-text"> <%= idlist.location%></p>
                    <p class="card-text"><%= idlist.country%></p>
                </div>
            </div>
          
            <!--    ************** Add Authorizaton ********* -->
            <%if(currUser && currUser._id.equals(idlist.owner._id)){ %>
            <div class="btns">
                <a href="/listings/<%=idlist._id%>/edit" 
                   class="btn btn-dark add-btn col-1 offset-2">Edit
                </a>

                <form method="POST" action="/listings/<%=idlist._id%>?_method=Delete">
                    <button class="btn btn-dark offset-2">Delete</button>
                </form>

              <%}%>
            </div>

         

                <hr/>
                <div class="col-8 offset-2">
                    <% if(currUser){%>
                        <h3>Rate Your Experience!!</h3>

                        <form method="POST" action="/listings/<%=idlist._id%>/reviews" novalidate class="needs-validation">
                            <!-- <div>
                                <label for="rating"  class="form-label"> Rating</label>
                                <input type="range" id="rating" name="review[rating]" required min="1" max="5"/>

                            </div> -->
                            <div class="mb-3 mt-3">
                                 <label for="rating"  class="form-label"> Rating</label>
                            <fieldset class="starability-slot">
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]"value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]"value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]"value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]"value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                            </fieldset>
                            </div>
                            <div>
                                <label for="comment" class="form-label" >Comments</label>
                                <textarea id="comment" rows="7" cols="10" class="form-control" name="review[comment]" required></textarea>

                                <div class="invalid-feedback"> Comments ur journey!!</div>

                            </div>

                            <div mt-3>
                            <button class="btn btn-dark">Submit</button>
                            </div>
                        </form>
                    <%}%>

     
            </div>
           <% if(idlist.reviews.length > 0){%>
                <p><b>All Reviews</b></p>
                <div class="row">
                    <%for( v of idlist.reviews){%>
                        <div class="card col-5 ms-3 mb-3 ">
                            <div class="card-body">
                                <h4 class="card-title">@<%=v.author.username%></h4>
                                <p class="starability-result" data-rating=<%=v.rating%>>
                                </p>
                                <p class="card-text"><%=v.comment%></p>
                                <!-- <p class="card-text"><v.rating%>star</p> -->

                            </div>
                        
                    
                            <form class="mb-3" method="post" action="/listings/<%=idlist._id%>/reviews/<%=v._id%>?_method=Delete">
                                <button class="btn btm-sm btn-dark">Delete</button>
                            </form>
                        
                        
                        </div>

                    
                        
                    <%}%>

                
                </div>
          <%}%>
        </div>
        <div class="col-6 offset-3 mb-3">
            <h2>Where you'll be</h2>
            <div id="map"></div>
        </div>
    </div>




<script src="/javascript/map.js"></script>